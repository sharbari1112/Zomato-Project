# Hugging Face dataset (Phase 1)
HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation

# Local catalog path after ingest (Phase 1)
CATALOG_PATH=data/catalog.parquet

# Filter / display caps — keep SHORTLIST_SIZE small (prompt tokens ≈ TPM)
SHORTLIST_SIZE=10
DEFAULT_TOP_K=3

# Optional override of cost tertiles, e.g. 500,1000 (Phase 1)
# BUDGET_CUTOFFS=

# Refuse to write the catalog below this row count (Phase 1)
# MIN_CATALOG_ROWS=100

# Groq LLM (Phase 4) — put the real key only in .env (gitignored)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3
# Cap output (+ reasoning) so one call cannot exhaust ~8K TPM budgets
LLM_MAX_COMPLETION_TOKENS=350
# gpt-oss: low | medium | high — use low on free tiers
LLM_REASONING_EFFORT=low
LLM_API_KEY=
# Or: GROQ_API_KEY=

# Prefer identical preference hashes for this many seconds (0 disables; Phase 5)
CACHE_TTL_SECONDS=300

# Deploy: comma-separated browser origins allowed to call the API (Vercel UI)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Serve PlateMatch from FastAPI (true locally; false on Render when UI is on Vercel)
SERVE_UI=true
